# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434

# Model Configuration - Choose models based on your needs
# Available models: llama3.2, llama3.1, mistral, etc.
# Run 'ollama list' to see available models
OLLAMA_JOB_DETECTION_MODEL=llama3.2
OLLAMA_JOB_EXTRACTION_MODEL=llama3.2
OLLAMA_CONFIRMATION_MODEL=llama3.2

# Logging
LOG_LEVEL=INFO
