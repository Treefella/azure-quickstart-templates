# BALANCED Profile - RECOMMENDED for most users
# Performance: ~8-12 minutes for 100 emails
# Accuracy: 92-95%
# Total model size: 3.3GB

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434

# Model Selection - Best accuracy/speed balance
OLLAMA_JOB_DETECTION_MODEL=llama3.2:3b
OLLAMA_JOB_EXTRACTION_MODEL=llama3.2
OLLAMA_CONFIRMATION_MODEL=llama3.2:1b

# Logging
LOG_LEVEL=INFO

# Required models to pull:
# ollama pull llama3.2:1b
# ollama pull llama3.2:3b
# ollama pull llama3.2
