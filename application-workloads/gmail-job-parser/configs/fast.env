# FAST Profile - Best for local CPU execution
# Performance: ~5-8 minutes for 100 emails
# Accuracy: 85-90%
# Total model size: 3.3GB

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434

# Model Selection - Optimized for speed
OLLAMA_JOB_DETECTION_MODEL=llama3.2:1b
OLLAMA_JOB_EXTRACTION_MODEL=llama3.2:3b
OLLAMA_CONFIRMATION_MODEL=llama3.2:1b

# Logging
LOG_LEVEL=INFO

# Required models to pull:
# ollama pull llama3.2:1b
# ollama pull llama3.2:3b
