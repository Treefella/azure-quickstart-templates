# ULTRA-FAST Profile - For processing thousands of emails
# Performance: ~3-5 minutes for 100 emails
# Accuracy: 80-85%
# Total model size: 1.3GB only!

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434

# Model Selection - Speed over accuracy
OLLAMA_JOB_DETECTION_MODEL=llama3.2:1b
OLLAMA_JOB_EXTRACTION_MODEL=llama3.2:1b
OLLAMA_CONFIRMATION_MODEL=llama3.2:1b

# Logging
LOG_LEVEL=INFO

# Required models to pull:
# ollama pull llama3.2:1b
