# ACCURATE Profile - For GPU or patient users
# Performance: ~15-20 minutes for 100 emails (CPU) or ~5-8 min (GPU)
# Accuracy: 95-98%
# Total model size: 6.7GB

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434

# Model Selection - Maximum accuracy
OLLAMA_JOB_DETECTION_MODEL=llama3.2:3b
OLLAMA_JOB_EXTRACTION_MODEL=llama3.1:8b
OLLAMA_CONFIRMATION_MODEL=llama3.2:3b

# Logging
LOG_LEVEL=INFO

# Required models to pull:
# ollama pull llama3.2:3b
# ollama pull llama3.1:8b
